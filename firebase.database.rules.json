{
  "rules": {
    ".read": false,
    ".write": false,
    "roomCodes": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "newData.isString()"
      }
    },
    "rooms": {
      "$roomId": {
        ".read": true,
        "state": {
          ".write": true
        },
        "joins": {
          "$playerId": {
            ".write": true,
            ".validate": "!newData.exists() || (newData.hasChildren(['displayName', 'joinedAt']) && newData.child('displayName').isString() && newData.child('displayName').val().length <= 18)"
          }
        },
        "leaves": {
          "$playerId": {
            ".write": true,
            ".validate": "!newData.exists() || newData.isNumber()"
          }
        },
        "inputs": {
          "$inputId": {
            ".write": true,
            ".validate": "!newData.exists() || (newData.hasChildren(['playerId', 'displayName', 'direction', 'receivedAt', 'windowId']) && newData.child('direction').val().matches(/^(up|down|left|right)$/))"
          }
        }
      }
    }
  }
}
